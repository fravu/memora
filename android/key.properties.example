# Kopiere diese Datei nach "key.properties" (im selben Ordner, android/)
# und trage die echten Werte deines Upload-Keystores ein.
#
# Upload-Keystore erzeugen (einmalig, Ausgabe sicher aufbewahren!):
#   keytool -genkey -v -keystore ~/upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# key.properties NIEMALS committen (steht in .gitignore) — enthaelt Passwoerter.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absoluter/pfad/zu/upload-keystore.jks
